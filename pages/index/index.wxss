.container {
  position: relative;
  width: 480px;
  height: 352px;
  min-height: 352px;
  padding: 12px 16px;
  box-sizing: border-box;
  background-color: var(--color-background);
  color: var(--color-text-primary);
  opacity: 1;
  transition: opacity 1200ms ease-in-out;
  overflow: hidden;
}

.container.screen-sleeping {
  opacity: 0;
}

.sleep-wake-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.main-card {
  position: relative;
  width: 100%;
  height: 328px;
  padding: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8px;
  border: 1px solid var(--border-color-muted);
  border-radius: 6px;
  background-color: var(--color-background);
  overflow: hidden;
}

.activity-statuses {
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  width: 148px;
  height: 14px;
  z-index: 2;
}

.activity-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 4px;
  white-space: nowrap;
}

.recognition-indicator,
.memory-indicator {
  width: 62px;
  height: 14px;
  flex-shrink: 0;
}

.recognition-indicator {
  margin-right: 24px;
}

.activity-icon-slot {
  width: 8px;
  height: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-breathe-dot {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
  background-color: var(--color-primary, #40ff5e);
  opacity: 0;
}

.status-breathe-dot.active {
  animation: status-breathe 4s ease-in-out infinite;
}

.activity-label {
  width: 50px;
  flex-shrink: 0;
  font-size: 11px;
  line-height: 14px;
  font-weight: 500;
  letter-spacing: 1px;
  color: var(--color-primary, #40ff5e);
}

@keyframes status-breathe {
  0%,
  100% {
    opacity: 0.45;
    box-shadow: 0 0 0 0 rgba(64, 255, 94, 0.06);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 0 4px rgba(64, 255, 94, 0.12);
  }
}

.status-panel {
  position: relative;
  min-height: 82px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 4px;
  padding: 8px 12px;
  padding-top: 30px;
  border-left: 2px solid var(--color-primary);
  background-color: var(--color-primary-06, rgba(64, 255, 94, 0.06));
}

.status-label {
  position: absolute;
  top: 8px;
  left: 12px;
}

.status-label,
.section-label,
.entry-meta {
  font-size: 11px;
  line-height: 14px;
  font-weight: 500;
  letter-spacing: 1px;
  color: var(--color-text-secondary);
}

.list-entry {
  min-height: 36px;
  padding: 6px 8px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid var(--border-color-muted);
  border-radius: 4px;
  background-color: transparent;
}

.list-entry.focused {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
}

.entry-meta {
  font-size: 10px;
  color: var(--color-text-secondary);
}

.status-text {
  font-size: 18px;
  line-height: 22px;
  font-weight: 500;
  color: var(--color-primary);
}

.status-detail {
  font-size: 12px;
  line-height: 16px;
  color: var(--color-primary, #40ff5e);
}

.status-meta {
  font-size: 10px;
  line-height: 14px;
  color: var(--color-primary-60, rgba(64, 255, 94, 0.6));
}

.button-row {
  display: flex;
  gap: 8px;
}

.nav-button {
  flex: 1;
  min-height: 36px;
  padding: 0 12px;
  border: 1px solid var(--border-color-default);
  border-radius: 4px;
  background-color: transparent;
  color: var(--color-text-primary);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1px;
}

.nav-button.focused {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
  color: var(--color-primary);
}

.empty-state {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  border: 1px dashed var(--border-color-strong);
  border-radius: 4px;
  background-color: var(--color-primary-06, rgba(64, 255, 94, 0.06));
  color: var(--color-text-secondary);
  font-size: 12px;
}

.item-list {
  height: 88px;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  color: var(--color-primary, #40ff5e);
}

.item-row {
  width: 100%;
  height: 44px;
  min-height: 44px;
  padding: 10px 4px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-color-muted);
  background-color: transparent;
  color: var(--color-primary, #40ff5e);
}

.item-row.focused {
  padding-left: 8px;
  padding-right: 8px;
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
}

.item-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  height: 100%;
  display: flex;
  align-items: center;
  font-size: 14px;
  line-height: 20px;
  color: var(--color-primary, #40ff5e);
}

.item-place {
  width: 150px;
  overflow: hidden;
  white-space: nowrap;
  text-align: right;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 1px;
  color: var(--color-primary-60, rgba(64, 255, 94, 0.6));
}

.item-row.focused .item-name,
.item-row.focused .item-place {
  color: var(--color-primary, #40ff5e);
}

.navigation-hint {
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 1px;
  color: var(--color-text-secondary);
}

.navigation-hint {
  text-align: center;
}
