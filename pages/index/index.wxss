.container {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28px;
  padding: 32px;
  box-sizing: border-box;
  background-color: var(--color-background);
  color: var(--color-text-primary);
}

.status-card {
  min-height: 120px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-radius: 16px;
  background-color: var(--color-surface);
  border: var(--border-width-thin, 1px) solid var(--border-color-default);
}

.status-label {
  font-size: 14px;
  color: var(--color-text-secondary);
}

.status-text {
  font-size: 28px;
  font-weight: 700;
  color: var(--color-primary);
}

.nav-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 16px;
  border-radius: var(--radius-md, 16px);
  background-color: var(--color-surface);
  border: var(--border-width-thin, 1px) solid var(--border-color-default);
}

.nav-item {
  width: 100%;
}

.nav-button {
  width: 100%;
  height: 56px;
  border-radius: var(--radius-sm, 12px);
  border: var(--border-width-thin, 1px) solid var(--color-primary);
  background-color: var(--color-primary);
  color: var(--color-background);
  font-size: 18px;
  font-weight: 700;
}
