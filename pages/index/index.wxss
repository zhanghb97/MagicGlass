.container {
  width: 480px;
  min-height: 352px;
  padding: 12px 16px;
  box-sizing: border-box;
  background-color: var(--color-background);
  color: var(--color-text-primary);
}

.main-card {
  width: 100%;
  padding: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12px;
  border: 1px solid var(--border-color-muted);
  border-radius: 6px;
  background-color: var(--color-background);
}

.status-panel {
  min-height: 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  padding: 8px 12px;
  border-left: 2px solid var(--color-primary);
  background-color: var(--color-primary-06, rgba(64, 255, 94, 0.06));
}

.status-label,
.section-label,
.entry-meta {
  font-size: 11px;
  line-height: 14px;
  font-weight: 500;
  letter-spacing: 1px;
  color: var(--color-text-secondary);
}

.list-entry {
  min-height: 36px;
  padding: 6px 8px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid var(--border-color-muted);
  border-radius: 4px;
  background-color: transparent;
}

.list-entry.focused {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
}

.entry-meta {
  font-size: 10px;
  color: var(--color-text-secondary);
}

.status-text {
  font-size: 22px;
  line-height: 26px;
  font-weight: 500;
  color: var(--color-primary);
}

.button-row {
  display: flex;
  gap: 8px;
}

.nav-button {
  flex: 1;
  min-height: 36px;
  padding: 0 12px;
  border: 1px solid var(--border-color-default);
  border-radius: 4px;
  background-color: transparent;
  color: var(--color-text-primary);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1px;
}

.nav-button.focused {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
  color: var(--color-primary);
}

.empty-state {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  border: 1px dashed var(--border-color-strong);
  border-radius: 4px;
  background-color: var(--color-primary-06, rgba(64, 255, 94, 0.06));
  color: var(--color-text-secondary);
  font-size: 12px;
}

.item-list {
  height: 104px;
}

.item-row {
  min-height: 40px;
  padding: 8px 4px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-color-muted);
  background-color: transparent;
}

.item-row.focused {
  padding-left: 8px;
  padding-right: 8px;
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
}

.item-name {
  font-size: 14px;
  line-height: 20px;
  color: var(--color-text-primary);
}

.item-place,
.navigation-hint {
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 1px;
  color: var(--color-text-secondary);
}

.navigation-hint {
  text-align: center;
}
