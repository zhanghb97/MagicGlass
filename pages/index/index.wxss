.container {
  width: 480px;
  min-height: 352px;
  padding: 12px 16px;
  box-sizing: border-box;
  background-color: var(--color-background);
  color: var(--color-text-primary);
}

.main-card {
  position: relative;
  width: 100%;
  padding: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12px;
  border: 1px solid var(--border-color-muted);
  border-radius: 6px;
  background-color: var(--color-background);
}

.activity-statuses {
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 2;
}

.activity-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
  white-space: nowrap;
}

.memory-dot {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
  background-color: var(--color-primary, #40ff5e);
  animation: memory-breathe 4s ease-in-out infinite;
}

.activity-label {
  font-size: 11px;
  line-height: 14px;
  font-weight: 500;
  letter-spacing: 1px;
  color: var(--color-primary, #40ff5e);
}

.recognition-spinner {
  width: 8px;
  height: 8px;
  box-sizing: border-box;
  border: 1px solid var(--color-primary-24, rgba(64, 255, 94, 0.24));
  border-top-color: var(--color-primary, #40ff5e);
  border-radius: 9999px;
  animation: recognition-spin 800ms linear infinite;
}

@keyframes memory-breathe {
  0%,
  100% {
    opacity: 0.45;
    box-shadow: 0 0 0 0 rgba(64, 255, 94, 0.06);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 0 4px rgba(64, 255, 94, 0.12);
  }
}

@keyframes recognition-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.status-panel {
  min-height: 82px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  padding: 8px 12px;
  padding-top: 28px;
  border-left: 2px solid var(--color-primary);
  background-color: var(--color-primary-06, rgba(64, 255, 94, 0.06));
}

.status-label,
.section-label,
.entry-meta {
  font-size: 11px;
  line-height: 14px;
  font-weight: 500;
  letter-spacing: 1px;
  color: var(--color-text-secondary);
}

.list-entry {
  min-height: 36px;
  padding: 6px 8px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid var(--border-color-muted);
  border-radius: 4px;
  background-color: transparent;
}

.list-entry.focused {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
}

.entry-meta {
  font-size: 10px;
  color: var(--color-text-secondary);
}

.status-text {
  font-size: 18px;
  line-height: 22px;
  font-weight: 500;
  color: var(--color-primary);
}

.status-detail {
  font-size: 12px;
  line-height: 16px;
  color: var(--color-primary, #40ff5e);
}

.status-meta {
  font-size: 10px;
  line-height: 14px;
  color: var(--color-primary-60, rgba(64, 255, 94, 0.6));
}

.button-row {
  display: flex;
  gap: 8px;
}

.nav-button {
  flex: 1;
  min-height: 36px;
  padding: 0 12px;
  border: 1px solid var(--border-color-default);
  border-radius: 4px;
  background-color: transparent;
  color: var(--color-text-primary);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1px;
}

.nav-button.focused {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
  color: var(--color-primary);
}

.empty-state {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  border: 1px dashed var(--border-color-strong);
  border-radius: 4px;
  background-color: var(--color-primary-06, rgba(64, 255, 94, 0.06));
  color: var(--color-text-secondary);
  font-size: 12px;
}

.item-list {
  height: 80px;
  color: var(--color-primary, #40ff5e);
}

.item-row {
  min-height: 40px;
  padding: 8px 4px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-color-muted);
  background-color: transparent;
  color: var(--color-primary, #40ff5e);
}

.item-row.focused {
  padding-left: 8px;
  padding-right: 8px;
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary-12, rgba(64, 255, 94, 0.12));
}

.item-name {
  font-size: 14px;
  line-height: 20px;
  color: var(--color-primary, #40ff5e);
}

.item-place {
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 1px;
  color: var(--color-primary-60, rgba(64, 255, 94, 0.6));
}

.item-row.focused .item-name,
.item-row.focused .item-place {
  color: var(--color-primary, #40ff5e);
}

.navigation-hint {
  font-size: 10px;
  line-height: 14px;
  letter-spacing: 1px;
  color: var(--color-text-secondary);
}

.navigation-hint {
  text-align: center;
}
