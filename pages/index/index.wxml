<view class="container">
  <card class="main-card" role="navigation">
    <view class="memory-indicator" ink:if="{{isMemoryActive}}">
      <view class="memory-dot"></view>
      <view class="memory-label">正在记忆</view>
    </view>

    <view class="status-panel">
      <view class="status-label">CURRENT STATUS</view>
      <view class="status-text">{{statusText}}</view>
      <view class="status-detail" ink:if="{{statusDetail}}">{{statusDetail}}</view>
      <view class="status-meta" ink:if="{{statusMeta}}">{{statusMeta}}</view>
    </view>

    <view class="button-row">
      <button
        class="nav-button {{navigationLevel === 'menu' && focusIndex === 0 ? 'focused' : ''}}"
        bindtap="toggleMemory"
      >{{memoryButtonText}}</button>
      <button
        class="nav-button {{navigationLevel === 'menu' && focusIndex === 1 ? 'focused' : ''}}"
        bindtap="findItem"
      >{{isListening ? '正在聆听' : '查找物品'}}</button>
    </view>

    <view
      class="list-entry {{navigationLevel === 'menu' && focusIndex === 2 ? 'focused' : ''}}"
      bindtap="enterItemList"
    >
      <view class="section-label">RECENT ITEMS</view>
      <view class="entry-meta">{{recentItems.length}} ITEMS · ENTER 浏览</view>
    </view>

    <view class="empty-state" ink:if="{{recentItems.length === 0}}">
      暂无物品记录
    </view>

    <scroll-view
      class="item-list"
      scroll-y="true"
      scroll-top="{{listScrollTop}}"
      ink:if="{{recentItems.length > 0}}"
    >
      <view
        id="item-{{index}}"
        class="item-row {{navigationLevel === 'list' && listFocusIndex === index ? 'focused' : ''}}"
        ink:for="{{recentItems}}"
        ink:key="name"
        data-index="{{index}}"
        bindtap="selectItem"
      >
        <view class="item-name">{{item.name}}</view>
        <view class="item-place">{{item.place}}</view>
      </view>
    </scroll-view>

    <view class="navigation-hint" ink:if="{{navigationLevel === 'menu'}}">
      一级菜单 · ENTER 进入/确认 · UP/DOWN 移动
    </view>
    <view class="navigation-hint" ink:if="{{navigationLevel === 'list'}}">
      最近物品 · UP/DOWN 滚动 · ENTER 选择 · BACK 返回菜单
    </view>
  </card>
</view>
