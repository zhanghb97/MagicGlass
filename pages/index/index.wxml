<view class="container {{screenSleeping || screenFading ? 'screen-sleeping' : ''}}" bindtap="noteUserActivity">
  <view class="sleep-wake-layer" catchtap="wakeScreen" ink:if="{{screenSleeping || screenFading}}"></view>
  <card class="main-card" role="{{controlsEnabled ? 'navigation' : 'group'}}">
    <view class="activity-statuses">
      <view class="activity-status recognition-indicator">
        <view class="activity-label">{{recognitionStatusText}}</view>
        <view class="activity-icon-slot">
          <view class="status-breathe-dot {{isRecognitionActive ? 'active' : ''}}"></view>
        </view>
      </view>
      <view class="activity-status memory-indicator">
        <view class="activity-label">{{isMemoryActive ? '正在记忆' : '等待记忆'}}</view>
        <view class="activity-icon-slot">
          <view class="status-breathe-dot {{isMemoryActive ? 'active' : ''}}"></view>
        </view>
      </view>
    </view>

    <view class="status-panel">
      <view class="status-label">CURRENT STATUS</view>
      <view class="status-text">{{statusText}}</view>
      <view class="status-detail" ink:if="{{statusDetail}}">{{statusDetail}}</view>
      <view class="status-meta" ink:if="{{statusMeta}}">{{statusMeta}}</view>
    </view>

    <view class="button-row" ink:if="{{controlsEnabled}}">
      <button
        class="nav-button {{navigationLevel === 'menu' && focusIndex === 0 ? 'focused' : ''}}"
        bindtap="toggleMemory"
      >{{memoryButtonText}}</button>
      <button
        class="nav-button {{navigationLevel === 'menu' && focusIndex === 1 ? 'focused' : ''}}"
        bindtap="findItem"
      >{{isListening ? '正在聆听' : '查找物品'}}</button>
    </view>

    <view
      class="list-entry {{navigationLevel === 'menu' && focusIndex === 2 ? 'focused' : ''}}"
      bindtap="enterItemList"
      ink:if="{{controlsEnabled}}"
    >
      <view class="section-label">RECENT ITEMS</view>
      <view class="entry-meta">{{recentItems.length}} ITEMS · ENTER 浏览</view>
    </view>

    <view class="empty-state" ink:if="{{recentItems.length === 0}}">
      暂无物品记录
    </view>

    <view
      class="item-list"
      ink:if="{{recentItems.length > 0}}"
    >
      <view
        id="item-{{item.sourceIndex}}"
        class="item-row {{navigationLevel === 'list' && listFocusIndex === item.sourceIndex ? 'focused' : ''}}"
        ink:for="{{visibleRecentItems}}"
        ink:key="name"
        data-index="{{item.sourceIndex}}"
        bindtap="selectItem"
      >
        <view class="item-name">{{item.name}}</view>
        <view class="item-place">{{item.place}}</view>
      </view>
    </view>

    <view class="navigation-hint" ink:if="{{controlsEnabled && navigationLevel === 'menu'}}">
      一级菜单 · ENTER 进入/确认 · UP/DOWN 移动
    </view>
    <view class="navigation-hint" ink:if="{{controlsEnabled && navigationLevel === 'list'}}">
      最近物品 · UP/DOWN 滚动 · ENTER 选择 · BACK 返回菜单
    </view>
  </card>
</view>
